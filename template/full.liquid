{% comment %}
  Full view (decision V1). A map of where the animal is today: its last fix
  if live, otherwise where it usually is on this day. A solid line back to
  where this leg began, a thinner one to where it is usually headed, a pill
  on the frame edge when that place is off screen, and a text box bottom left.
  With the setting "All followed animals" (rows in the payload) the TRMNL X
  (lg:) shows the list and the map instead (owner, 2026-09-29, wireframe
  board 11); every other device keeps the single view.

  Needs shared.liquid (components and the map script). The text box is
  map_of_the_day trmnl/example-markup.liquid:242.
{% endcomment %}

{% if state != "ok" %}
{% render "otm_message", species: species, status: status %}
{% else %}
<div class="layout">
  <div class="{% if rows %}lg:hidden {% endif %}relative w--full h--full" data-otm-scope>
    <div class="map w--full h--full" data-otm-map data-otm-with-pill data-geo="{{ geo | escape }}">

      {% comment %} Shown until the map draws, and instead of it if it never
         does: the words alone still answer the question. {% endcomment %}
      <div class="absolute inset--1 flex flex--col flex--center-x flex--center-y" data-otm-waiting>
        <span class="value value--large">{{ species }}</span>
        <span class="label">{{ where }}</span>
      </div>

      {% comment %} Bottom-left corner stack (topic 10): the text box, and above it
         the pill when the pill's own edge spot would land on the box. {% endcomment %}
      <div class="absolute bottom--2 left--2 z--3 flex flex--col flex--left gap--small" data-otm-corner>
      <div class="p--2 {% if photo != blank %}w--max-[72cqw] lg:w--max-[64cqw]{% else %}w--max-[62cqw] lg:w--max-[55cqw]{% endif %} bg--canvas outline" data-otm-box>
        <div class="flex flex--row flex--left flex--top gap">
        {% if photo != blank %}<img class="image image--cover w--28 h--28 no-shrink" src="{{ photo }}" alt="">{% endif %}
        {% comment %} One line per span, stacked: inside .content the spans ran
           on as one paragraph (seen in the first render). {% endcomment %}
        <div class="flex flex--col flex--left gap--xsmall text--left">
          <span class="title title--small">{{ species }}{% if name != "" %} · {{ name }}{% endif %}</span>
          <span class="label">{{ where }}</span>
          <span class="label label--small">{{ status }}</span>
          <span class="description">{{ fact }}</span>
        </div>
        </div>
      </div>
      </div>
    </div>
    <div class="hidden" data-otm-toward>{{ toward | escape }}</div>
  </div>
  {% if rows %}
  {% comment %} Multi (X only): the list left and the map right; in portrait
     the map on top and the list below in two columns. {% endcomment %}
  <div class="hidden lg:flex flex--row portrait:flex--col-reverse gap w--full h--full" data-otm-scope>
    <div class="w--[34cqw] portrait:w--full portrait:h--[44cqh] no-shrink flex flex--col flex--top" data-otm-list>
      {% render "otm_list", rows: rows, current: current, size: 7, grid: "grid--cols-1 portrait:grid--cols-2", span: "col--span-1 portrait:col--span-2", fact_on: true, species: species, name: name, where: where, toward: toward, fact: fact, status: status, photo: photo %}
    </div>
    <div class="map stretch" data-otm-map data-geo="{{ geo | escape }}">
      <div class="absolute inset--1 hidden flex flex--col flex--center-x flex--center-y" data-otm-waiting>
        <span class="label">{{ where }}</span>
      </div>
    </div>
  </div>
  {% endif %}
</div>
<script>OTM.start(document.currentScript.previousElementSibling);</script>
{% endif %}
