{% comment %}
  Half vertical view (owner, 2026-09-29, wireframe board 12). Single: the map
  on top and the text below, with the destination and the fact. Multi (X only,
  lg:): the map on top and the list below (four animals, one expanded).
  Needs shared.liquid.
{% endcomment %}

{% if state != "ok" %}
{% render "otm_message", species: species, status: status %}
{% else %}
<div class="layout">
  <div class="{% if rows %}lg:hidden {% endif %}flex flex--col gap w--full h--full" data-otm-scope>
    <div class="map h--[62cqh] portrait:h--[56cqh] w--full no-shrink" data-otm-map data-geo="{{ geo | escape }}">
      <div class="absolute inset--1 hidden flex flex--col flex--center-x flex--center-y" data-otm-waiting>
        <span class="label">{{ where }}</span>
      </div>
    </div>
    <div class="stretch flex flex--col flex--left flex--top">
      {% render "otm_text", size: "half", species: species, name: name, where: where, toward: toward, fact: fact, status: status %}
    </div>
  </div>
  {% if rows %}
  <div class="hidden lg:flex flex--col gap w--full h--full" data-otm-scope>
    <div class="map h--[38cqh] portrait:h--[50cqh] w--full no-shrink" data-otm-map data-geo="{{ geo | escape }}">
      <div class="absolute inset--1 hidden flex flex--col flex--center-x flex--center-y" data-otm-waiting>
        <span class="label">{{ where }}</span>
      </div>
    </div>
    <div class="stretch w--full" data-otm-list>
      {% render "otm_list", rows: rows, current: current, size: 4, cols: 1, fact_on: true, species: species, name: name, where: where, toward: toward, fact: fact, status: status, photo: photo %}
    </div>
  </div>
  {% endif %}
</div>
<script>OTM.start(document.currentScript.previousElementSibling);</script>
{% endif %}
